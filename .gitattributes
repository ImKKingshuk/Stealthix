# Normalize text files across macOS, Linux, and Windows checkouts.
* text=auto eol=lf

# Source and config
*.py text eol=lf
*.pyi text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf

# Windows scripts may require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary artifacts
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.tgz binary
*.whl binary
*.so binary
*.dylib binary
*.dll binary
*.exe binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.pcap binary
*.pcapng binary
